# ==========================================
# TRACKING & ANALYTICS
# ==========================================

# Facebook Pixel ID - Para tracking de visitantes y remarketing
# Obtener en: https://business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=your_fb_pixel_id_here

# Google Analytics 4 Tracking ID
# Obtener en: https://analytics.google.com/
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Facebook Conversions API Token (Backend)
# Obtener en: https://business.facebook.com/events_manager > Settings > Conversions API
FB_CONVERSIONS_API_TOKEN=your_conversions_api_token_here

# ==========================================
# DYNAMIC PRICING CONFIGURATION
# ==========================================

# Activar/desactivar precios dinámicos
NEXT_PUBLIC_ENABLE_DYNAMIC_PRICING=true

# Descuento máximo permitido (porcentaje)
DYNAMIC_PRICING_MAX_DISCOUNT=35

# Descuento mínimo para mostrar (porcentaje)
DYNAMIC_PRICING_MIN_DISCOUNT=5

# ==========================================
# REMARKETING
# ==========================================

# Tiempo de espera antes de marcar carrito como abandonado (minutos)
CART_ABANDONMENT_THRESHOLD=5

# Activar emails de recuperación de carrito
ENABLE_CART_RECOVERY_EMAIL=true

# Activar SMS de recuperación (opcional)
ENABLE_CART_RECOVERY_SMS=false

# ==========================================
# A/B TESTING
# ==========================================

# Activar A/B testing de precios
ENABLE_PRICE_AB_TESTING=false

# Variantes de testing (JSON array)
PRICE_TEST_VARIANTS='[{"name":"control","multiplier":1.0},{"name":"discount_5","multiplier":0.95}]'

# ==========================================
# API KEYS (Ya existentes)
# ==========================================

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/laboratorio

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# SEO & ANALYTICS BACKEND
# ==========================================

# Google Search Console Verification
GOOGLE_SITE_VERIFICATION=your_verification_code

# Server-side analytics endpoint
ANALYTICS_API_ENDPOINT=http://localhost:3000/api/analytics

# ==========================================
# COMPETITOR TRACKING
# ==========================================

# Activar tracking de competencia
ENABLE_COMPETITOR_TRACKING=true

# Dominios de competidores (separados por coma)
COMPETITOR_DOMAINS=chopo.com.mx,medicapolanco.com,saluddigna.com

# ==========================================
# SECURITY & PRIVACY
# ==========================================

# Cookie sameSite policy
COOKIE_SAME_SITE=lax

# Cookie  secure flag (true para production)
COOKIE_SECURE=false

# GDPR mode (true para EU users)
GDPR_MODE=false
